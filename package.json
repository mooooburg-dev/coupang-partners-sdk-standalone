{
  "name": "coupang-partners-sdk-standalone",
  "version": "1.3.2",
  "description": "TypeScript SDK for the Coupang Partners API (쿠팡 파트너스) — product search, GoldBox, CoupangPL, deeplinks and reports. Works on Node.js, Cloudflare Workers, Deno and Bun.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build && npm test",
    "example": "ts-node examples/basic-usage.ts"
  },
  "keywords": [
    "coupang",
    "partners",
    "affiliate",
    "sdk",
    "typescript",
    "nodejs",
    "authentication",
    "hmac",
    "coupang-partners",
    "coupang-api",
    "쿠팡파트너스",
    "deeplink",
    "goldbox",
    "cloudflare-workers",
    "edge"
  ],
  "author": {
    "name": "mooooburg-dev",
    "url": "https://github.com/mooooburg-dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mooooburg-dev/coupang-partners-sdk-standalone.git"
  },
  "bugs": {
    "url": "https://github.com/mooooburg-dev/coupang-partners-sdk-standalone/issues"
  },
  "homepage": "https://cp-sdk-console.vercel.app",
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/node-fetch": "^2.6.13",
    "abort-controller": "^3.0.0",
    "dotenv": "^17.2.2",
    "node-fetch": "^2.7.0"
  }
}
